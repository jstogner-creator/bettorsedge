# Bettors Edge environment variables
# Copy this file to .env locally. Never commit real secrets.

# Public app URL used for CORS and Stripe redirects.
# Production example: https://www.bettorsedge.com
APP_URL=

# Firebase Admin credentials must be available to the server runtime.
# Prefer platform-managed credentials when deploying to Google Cloud.
GOOGLE_APPLICATION_CREDENTIALS=

# OpenAI API key. Server-side only. All AI analysis uses OpenAI.
OPENAI_API_KEY=

# Optional OpenAI model override. Default is gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Stripe configuration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# Kalshi API credentials.
KALSHI_API_KEY=
KALSHI_API_SECRET=
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# API-Sports key used by NBA, basketball, MLB, and NHL proxies.
API_SPORTS_KEY=

# Optional runtime flags.
NODE_ENV=production
PORT=3000
DISABLE_HMR=true
